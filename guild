name: Build DJ Music Analyzer for Windows 11

on:
  workflow_dispatch:
  push:
    branches: [main, master]

jobs:
  windows-exe:
    runs-on: windows-latest
    timeout-minutes: 45
    steps:
      - name: Get source code
        uses: actions/checkout@v4
      - name: Set up Python on GitHub runner (not on your PC)
        uses: actions/setup-python@v5
        with:
          python-version: '3.12'
          architecture: 'x64'
          cache: 'pip'
          cache-dependency-path: requirements.txt
      - name: Install build dependencies
        shell: pwsh
        run: |
          python -m pip install --upgrade pip
          python -m pip install -r requirements.txt "pyinstaller>=6.10,<7"
      - name: Package Windows app
        shell: pwsh
        run: |
          python -m PyInstaller --noconfirm --clean --windowed --onedir --name DJMusicAnalyzer --collect-all librosa --collect-all soundfile --collect-all audioread --collect-all scipy --collect-all numba main.py
      - name: Confirm exe exists
        shell: pwsh
        run: |
          if (-not (Test-Path 'dist/DJMusicAnalyzer/DJMusicAnalyzer.exe')) { throw 'EXE not found' }
          Get-Item 'dist/DJMusicAnalyzer/DJMusicAnalyzer.exe' | Select-Object Name,Length
      - name: Create zip for download
        shell: pwsh
        run: Compress-Archive -Path 'dist/DJMusicAnalyzer' -DestinationPath 'DJMusicAnalyzer_Windows11.zip' -Force
      - name: Upload app ZIP
        uses: actions/upload-artifact@v4
        with:
          name: DJMusicAnalyzer_Windows11
          path: DJMusicAnalyzer_Windows11.zip
          if-no-files-found: error
          retention-days: 30
